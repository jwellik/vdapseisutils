 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# CrossSection tutorial (Bokeh)\n",
    "\n",
    "Examples using `vdapseisutils.core.maps.bokeh.CrossSection` with real topographic profiles."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from bokeh.io import output_notebook, show\n",
    "from obspy.clients.fdsn import Client\n",
    "import obspy\n",
    "\n",
    "from vdapseisutils.core.maps.bokeh import CrossSection\n",
    "\n",
    "output_notebook()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "VOLCANOES = {\n",
    "    \"Mount Augustine\": {\"origin\": (59.3626, -153.4333), \"azimuth\": 75, \"radius_km\": 35},\n",
    "    \"Mount Rainier\": {\"origin\": (46.8523, -121.7603), \"azimuth\": 95, \"radius_km\": 45},\n",
    "    \"Crater Lake\": {\"origin\": (42.9446, -122.1090), \"azimuth\": 110, \"radius_km\": 35},\n",
    "    \"Kilauea\": {\"origin\": (19.4210, -155.2870), \"azimuth\": 45, \"radius_km\": 40},\n",
    "    \"Yellowstone\": {\"origin\": (44.4280, -110.5885), \"azimuth\": 70, \"radius_km\": 70},\n",
    "}"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Mount Augustine"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "cs_aug = CrossSection(\n",
    "    origin=VOLCANOES[\"Mount Augustine\"][\"origin\"],\n",
    "    azimuth=VOLCANOES[\"Mount Augustine\"][\"azimuth\"],\n",
    "    radius_km=VOLCANOES[\"Mount Augustine\"][\"radius_km\"],\n",
    "    depth_extent=(-25, 4),\n",
    "    figsize=(9, 3.5),\n",
    ")\n",
    "cs_aug.set_title(\"Mount Augustine cross section\")\n",
    "show(cs_aug.figure)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
