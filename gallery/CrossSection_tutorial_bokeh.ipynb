  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### K\u012blauea (profile + inventory + catalog)\n",
    "\n",
    "This uses the same IRIS inventory request and bundled catalog as `Mapping_tutorial_bokeh.ipynb`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "kilauea = {\n",
    "    \"origin\": VOLCANOES[\"Kilauea\"][\"origin\"],\n",
    "    \"azimuth\": VOLCANOES[\"Kilauea\"][\"azimuth\"],\n",
    "    \"radius_km\": VOLCANOES[\"Kilauea\"][\"radius_km\"],\n",
    "    \"map_extent\": [-155.500, -154.800, 19.200, 19.500],\n",
    "}\n",
    "\n",
    "client = Client(\"IRIS\")\n",
    "inv = client.get_stations(\n",
    "    network=\"HV\",\n",
    "    minlatitude=kilauea[\"map_extent\"][2],\n",
    "    maxlatitude=kilauea[\"map_extent\"][3],\n",
    "    minlongitude=kilauea[\"map_extent\"][0],\n",
    "    maxlongitude=kilauea[\"map_extent\"][1],\n",
    ")\n",
    "cat_kilauea = obspy.read_events(\"../data/catalog_kilauea_eruption.xml\", format=\"QUAKEML\")\n",
    "\n",
    "cs_kilauea = CrossSection(\n",
    "    origin=kilauea[\"origin\"],\n",
    "    azimuth=kilauea[\"azimuth\"],\n",
    "    radius_km=kilauea[\"radius_km\"],\n",
    "    depth_extent=(-25, 4),\n",
    "    figsize=(10, 4),\n",
    ")\n",
    "cs_kilauea.set_title(\"K\u012blauea cross section\")\n",
    "cs_kilauea.plot_inventory(inv, c=\"black\", alpha=0.9)\n",
    "cs_kilauea.plot_catalog(cat_kilauea, alpha=0.6)\n",
    "show(cs_kilauea.figure)"
   ]
  },
