   "source": [
    "import numpy as np\n",
    "from bokeh.io import output_notebook, show\n",
    "\n",
    "from vdapseisutils.core.maps.bokeh import CrossSection\n",
    "\n",
    "output_notebook()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Helpers and volcano inputs"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [],
   "source": [
    "VOLCANOES = {\n",
    "    \"Mount Augustine\": {\"origin\": (59.3626, -153.4333), \"azimuth\": 75, \"radius_km\": 35},\n",
    "    \"Mount Rainier\": {\"origin\": (46.8523, -121.7603), \"azimuth\": 95, \"radius_km\": 45},\n",
    "    \"Crater Lake\": {\"origin\": (42.9446, -122.1090), \"azimuth\": 110, \"radius_km\": 35},\n",
    "    \"Kilauea\": {\"origin\": (19.4210, -155.2870), \"azimuth\": 45, \"radius_km\": 40},\n",
    "    \"Yellowstone\": {\"origin\": (44.4280, -110.5885), \"azimuth\": 70, \"radius_km\": 70},\n",
    "}\n",
    "\n",
    "def synthetic_points(origin, n=200, seed=0):\n",
    "    rng = np.random.default_rng(seed)\n",
    "    lat0, lon0 = origin\n",
    "    lats = lat0 + rng.normal(0, 0.10, size=n)\n",
    "    lons = lon0 + rng.normal(0, 0.10, size=n)\n",
    "    depths_km = rng.uniform(0.5, 18.0, size=n)\n",
    "    return lats, lons, depths_km\n",
    "\n",
    "def show_cross_section(name, spec, seed=0):\n",
    "    cs = CrossSection(\n",
    "        origin=spec[\"origin\"],\n",
    "        azimuth=spec[\"azimuth\"],\n",
    "        radius_km=spec[\"radius_km\"],\n",
    "        depth_extent=(-25, 4),\n",
    "        figsize=(9, 3.5),\n",
    "        title=f\"{name} - Bokeh Cross Section\",\n",
    "    )\n",
    "    lats, lons, depths_km = synthetic_points(spec[\"origin\"], seed=seed)\n",
    "    cs.scatter(\n",
    "        lat=lats,\n",
    "        lon=lons,\n",
    "        z=depths_km,\n",
    "        z_unit=\"km\",\n",
    "        z_dir=\"depth\",\n",
    "        s=20,\n",
    "        alpha=0.7,\n",
    "        color=\"royalblue\",\n",
    "        hover_text=[f\"{name} event {i}\" for i in range(len(depths_km))],\n",
    "    )\n",
    "    show(cs.figure)\n"
   ]
  },
